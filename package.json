{
  "name": "tournamenter-app",
  "productName": "Tournamenter",
  "private": true,
  "description": "Manage local Tournamenter servers",
  "version": "2.0.0-beta.1",
  "license": "MIT",
  "author": {
    "name": "Ivan Seidel",
    "email": "ivan@tendadigital.net"
  },
  "homepage": "https://github.com/TendaDigital/TournamenterApp",
  "repository": "github:TendaDigital/TournamenterApp",
  "engines": {
    "node": ">=24.14.0"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "stage": "node scripts/stage-runtime.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "npm": "11.21.3",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "com.tournamenter",
    "asar": true,
    "files": [
      "desktop/**/*",
      "public/**/*",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "runtime-local",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "./scripts/check-runtime.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 120,
      "contents": [
        {
          "x": 610,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 150,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "executableName": "tournamenter-app"
    }
  }
}
